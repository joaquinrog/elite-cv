{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elite CV sources document v2",
  "type": "object",
  "required": ["schema_version", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id", "type", "label", "path", "confidentiality", "collected_at", "fingerprint"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "confidentiality": {"enum": ["public", "private", "restricted"]}, "collected_at": {"type": "string", "minLength": 1}, "fingerprint": {"type": ["string", "null"]}}}}
  }
}
