{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elite CV variant document v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "target_role", "sections", "include_entries", "include_skill_groups", "contact_fields"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "target_role": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "enum": ["en-US", "es-MX"]},
    "page_size": {"enum": ["letter", "a4"]},
    "density": {"enum": ["short", "medium", "dense"]},
    "page_target": {"type": "integer", "minimum": 1},
    "sections": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "include_entries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "include_skill_groups": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contact_fields": {"type": "array", "items": {"enum": ["email", "phone", "location", "links"]}},
    "exclude_entries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "allowed_disclosures": {"type": "array", "items": {"enum": ["shareable", "restricted", "private"]}}
  }
}
